{
  "team_id": "Team07",
  "stage": 3,
  "detector": "YOLO11n",
  "pretrained_source": "https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt",
  "input_size": 320,
  "class_order": ["crazing", "inclusion", "patches", "pitted_surface", "rolled_in_scale", "scratches"],
  "confidence_threshold": 0.25,
  "nms_iou_threshold": 0.7,
  "bbox_format": "xyxy_pixel",
  "seed": 42,
  "checkpoint_file": "stage3_model.pt",
  "training": {
    "epochs": 60,
    "batch": 16,
    "optimizer": "AdamW",
    "lr0": 0.001,
    "lrf": 0.01,
    "weight_decay": 0.0005,
    "warmup_epochs": 3.0,
    "patience": 60,
    "mosaic": 0.5,
    "close_mosaic": 10,
    "degrees": 0.0,
    "translate": 0.1,
    "scale": 0.3,
    "fliplr": 0.5,
    "flipud": 0.5,
    "hsv_h": 0.0,
    "hsv_s": 0.0,
    "hsv_v": 0.2,
    "mixup": 0.0,
    "amp": true,
    "deterministic": true,
    "workers": 0
  },
  "selection_metric": "validation mAP@0.5",
  "evaluation": {
    "ap_min_confidence": 0.001,
    "matching_iou_threshold": 0.5,
    "max_detections": 300,
    "thresholds": [0.05, 0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9]
  }
}
